# Geliştirme sunucusunun (npm run dev) /api isteklerini aktaracağı stok servisi.
DEV_API_PROXY_TARGET=http://localhost:5154

# Adres alt alan adı içermediğinde (ör. localhost) X-Tenant başlığıyla gönderilen varsayılan tenant. Yalnızca
# geliştirme sunucusunda (npm run dev) kullanılır ve yalnızca Development ortamındaki API bu başlığı dikkate alır;
# tenant adresinden (ör. http://acme.omnisync.localhost:5173) açıldığında gerekmez.
VITE_DEV_TENANT=acme
