# Tarayıcıdan çağrılan API kök yolu (aynı origin; Vite/nginx proxy).
VITE_API_BASE_URL=/api/v1

# Geliştirme sunucusunun (npm run dev) stok API isteklerini aktaracağı StockService.
DEV_API_PROXY_TARGET=http://localhost:5154

# Kimlik / kullanıcı / oturum / audit uçları UserService'e aktarılır.
DEV_USER_API_PROXY_TARGET=http://localhost:5155

# Adres alt alan adı içermediğinde (ör. localhost) X-Tenant başlığıyla gönderilen varsayılan tenant. Yalnızca
# geliştirme sunucusunda (npm run dev) kullanılır ve yalnızca Development ortamındaki API bu başlığı dikkate alır;
# tenant adresinden (ör. http://atagreen.omnisync.localhost:5173) açıldığında gerekmez.
VITE_DEV_TENANT=atagreen
