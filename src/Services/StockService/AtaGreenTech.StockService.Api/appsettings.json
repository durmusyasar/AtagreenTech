{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "JwtSettings": {
    "Issuer": "AtaGreenTech.StockService",
    "Audience": "AtaGreenTech.Apps"
  },
  "Cors": {
    "AllowedOrigins": ["https://atagreen.tech"],
    "TenantOriginPatterns": ["https://{tenant}.atagreen.tech"]
  },
  "Localization": {
    "DefaultLanguage": "tr"
  },
  "TenantMigrations": {
    "RunOnStartup": false,
    "MaxDegreeOfParallelism": 1
  },
  "AllowedHosts": "*"
}
