{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "JwtSettings": {
    "Issuer": "AtaGreenTech.UserService",
    "Audience": "AtaGreenTech.Apps"
  },
  "InternalProvisioning": {
    "ApiKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "EmailVerificationHours": 24,
    "PasswordResetHours": 1,
    "InvitationDays": 3,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AuthRateLimitPermitLimit": 5,
    "AuthRateLimitWindowMinutes": 1,
    "MfaIssuer": "OmniSync",
    "MfaRecoveryCodeCount": 8,
    "PublicAppBaseUrl": "https://omnisync.com",
    "Bootstrap": {
      "Email": "admin@omnisync.com",
      "Username": "admin",
      "FirstName": "System",
      "LastName": "Admin"
    }
  },

  "FeatureFlags": {
    "EnableOidcSso": false
  },
  "OidcProviders": {
    "Google": {
      "Authority": "https://accounts.google.com",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/api/v1/auth/sso/google/callback"
    },
    "Microsoft": {
      "Authority": "https://login.microsoftonline.com/common/v2.0",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/api/v1/auth/sso/microsoft/callback"
    }
  },

  "TenantResolution": {
    "RootDomains": ["omnisync.com", "omnisync.com.tr"]
  },
  "Cors": {
    "AllowedOrigins": ["https://omnisync.com", "https://omnisync.com.tr"],
    "TenantOriginPatterns": ["https://{tenant}.omnisync.com", "https://{tenant}.omnisync.com.tr"]
  },
  "Localization": {
    "DefaultLanguage": "tr"
  },
  "TenantMigrations": {
    "RunOnStartup": false,
    "MaxDegreeOfParallelism": 1
  },
  "AllowedHosts": "*"
}
