# docker-compose.yml için isteğe bağlı ayarlar. Kopyalayıp düzenleyin: cp .env.example .env
# Gizli değerler buraya değil, secrets/ dizinine yazılır (deploy/generate-secrets.sh).

# İmaj etiketi
ATAGREEN_VERSION=latest

# Stok servisinin sunucunun loopback arayüzünde yayınlandığı port (reverse proxy buraya bağlanır)
STOCK_SERVICE_HTTP_PORT=5001

# Web arayüzünün sunucunun loopback arayüzünde yayınlandığı port (reverse proxy tenant alt alan adlarını buraya yönlendirir)
ATAGREEN_WEB_PORT=3000

# Stok servisinin dış ağı ve X-Forwarded-* başlıklarına güvenilen proxy adresi (ağın gateway'i)
ATAGREEN_EDGE_SUBNET=172.31.0.0/24
ATAGREEN_TRUSTED_PROXY=172.31.0.1

# İmaj derlenirken OmniSync.Core paketlerinin indirildiği GitHub Packages kullanıcısı. Token (GITHUB_PACKAGES_TOKEN)
# buraya yazılmaz; derleme komutunda ortam değişkeni olarak verilir.
GITHUB_USERNAME=durmusyasar
